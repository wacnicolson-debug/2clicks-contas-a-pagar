# Banco de dados (Supabase Postgres — pegue em "Connect" > aba "ORM" > Prisma, no painel do projeto)
# DATABASE_URL = conexão com pool (app rodando) | DIRECT_URL = conexão direta (só migrações)
DATABASE_URL="postgresql://postgres.xxxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase (armazenamento dos documentos enviados)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."

# API da Anthropic (leitura dos documentos por IA)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Sheets — login OAuth (Google Cloud > APIs e Serviços > Clientes > Criar cliente
# > App da Web > URI de redirecionamento: {APP_BASE_URL}/api/auth/google/callback).
# Cada empresa conecta o próprio Google dela (botão "Conectar Google Sheets" no painel);
# a planilha nasce direto no Drive dela, sem precisar de conta de serviço.
GOOGLE_OAUTH_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-..."
APP_BASE_URL="http://localhost:3000"

# Sessão de login (uma string aleatória longa, gerada uma vez e mantida em segredo)
SESSION_SECRET="troque-por-uma-string-aleatoria-longa"

# Inngest (fila de processamento em segundo plano — chaves do painel do Inngest em produção;
# em desenvolvimento local, o Inngest Dev Server não exige chaves)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
